RHA_HOST=0.0.0.0
RHA_PORT=8090
RHA_GO_BASE_URL=http://127.0.0.1:8081
RHA_INTERNAL_TOKEN=<your-internal-token>
RHA_REQUEST_TIMEOUT_SECONDS=120

RHA_LLM_BASE_URL=https://api.deepseek.com/v1
